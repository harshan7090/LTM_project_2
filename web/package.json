{
  "name": "integrityai-console",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "IntegrityAI Console — React frontend for pipeline corrosion risk assessment",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:landing": "vite build --config vite.landing.config.ts",
    "check:landing": "cd .. && node web/scripts/check-landing.mjs && node web/scripts/check-journey.mjs",
    "check:map": "cd .. && node web/scripts/check-projection.mjs && node web/scripts/check-orbit.mjs",
    "check:visual": "cd .. && node web/scripts/shoot-journey.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.2",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.11.2",
    "framer-motion": "^13.4.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.0.1",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
