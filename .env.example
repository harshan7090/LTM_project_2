# Copy this file to .env and adjust as needed. All values have sensible
# defaults, so an empty/missing .env is fine to start with.

# Random seed for reproducible synthetic data generation and model training.
RANDOM_SEED=42

# Database connection. Defaults to a local SQLite file if unset — no setup
# needed, works directly with DB Browser for SQLite.
#
# To use PostgreSQL + pgAdmin instead, uncomment and fill in:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/integrityai


# ---------------------------------------------------------------------------
# AI assistant
# ---------------------------------------------------------------------------
# The console's assistant answers corrosion/integrity questions grounded in
# this database, and can analyse uploaded pipeline photos.
#
# Leave LLM_PROVIDER unset to AUTO-DETECT in this order:
#     groq (if key set) -> huggingface (if key set) -> ollama (if running) -> mock
#
# Set it explicitly to pin one backend. An explicit choice is never silently
# overridden, so a broken config shows up as an error instead of quietly
# using something else.
#
#   ollama       local, free, no key, no outbound network calls
#   groq         free tier, much faster, needs a key from console.groq.com
#   huggingface  free tier, needs a token from huggingface.co/settings/tokens
#   mock         canned demo responses, no LLM needed at all
#
# LLM_PROVIDER=ollama

# --- Ollama (local) --------------------------------------------------------
# Nothing to configure if Ollama is running on its default port.
# OLLAMA_HOST=http://localhost:11434
#
# By default the first installed model is used. Pin one instead:
# LLM_MODEL=llama3.2:1b
#
# PHOTO ANALYSIS NEEDS A VISION MODEL. Text-only models (llama3, llama3.2:1b,
# mistral, phi) cannot see images. Install one with:
#     ollama pull llama3.2-vision      (~8 GB)
#     ollama pull moondream            (~1.7 GB, much smaller and faster)
# It is then auto-detected. To pin it explicitly:
# LLM_VISION_MODEL=llama3.2-vision

# --- Groq (free tier, fastest) ---------------------------------------------
# Get a free key at https://console.groq.com — then uncomment:
# GROQ_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- HuggingFace (free tier) -----------------------------------------------
# Token from https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your_token_here

# --- Upload limits ---------------------------------------------------------
# Max size for an uploaded pipeline photo, in bytes. Default 8 MB.
# MAX_IMAGE_BYTES=8388608

# --- OpenRouter (optional, free tier) ---------------------------------------
# The single biggest available improvement to photo analysis. Without it the
# vision stage runs on local moondream (1.8B, chosen because this machine has
# no discrete GPU); with it, the console discovers a free vision model from
# OpenRouter's live catalogue at runtime.
#
# Get a free key: https://openrouter.ai/keys
# Nothing is hardcoded - the free roster turns over constantly, so the model
# is selected from the live /models response. See backend/openrouter.py.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# ---------------------------------------------------------------- fleet map
# The console's map draws raster tiles relayed through the backend, so this
# key is never sent to the browser and the CSP stays img-src 'self'.
#
#   MAP_PROVIDER=auto      geoapify when a key is set, else osm  (default)
#   MAP_PROVIDER=geoapify  force Geoapify; blank tiles without a key
#   MAP_PROVIDER=osm       OpenStreetMap raster, no key needed
#   MAP_PROVIDER=none      skip tiles, draw the vector outline only
#
# MAP_STYLE applies to Geoapify: satellite | osm-bright | dark-matter-brown.
# Satellite REQUIRES a key - Geoapify returns 401 for it otherwise.
# Free key (3,000 tiles/day): https://myprojects.geoapify.com/
MAP_PROVIDER=auto
MAP_STYLE=satellite
GEOAPIFY_API_KEY=
