{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Full Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_pipeline.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Fetch PHMSA Data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/fetch_phmsa_data.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Load Data into Database",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/load_to_database.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run Console (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["backend.main:app", "--reload", "--port", "8010"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Pytest: All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
